# ─── App ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////data/db/app.db
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
LOG_LEVEL=INFO

FLASK_SECRET_KEY=dev-secret-change-me
MAX_UPLOAD_MB=4096

# ─── Inference target ───────────────────────────────────────────────
# DEFAULT: GPU on Grafilab via SSH tunnel.
# Open the tunnel first (see scripts/tunnel.ps1), then start the stack.
# The worker reaches the tunnel through the host's loopback.
INFERENCE_API_URL=http://host.docker.internal:8000
INFERENCE_TRANSPORT=upload
INFERENCE_TIMEOUT_S=3600

# Local CPU alternative (uncomment + `docker compose --profile local up`):
# INFERENCE_API_URL=http://inference_api:8000
# INFERENCE_TRANSPORT=path

# ─── YOLOv8-pose / ByteTrack ────────────────────────────────────────
# These env vars are read by the inference_api service. On Grafilab,
# export them in the shell that runs uvicorn (see scripts/grafilab_setup.sh).
INFERENCE_DEVICE=cuda
INFERENCE_MODEL=yolov8s-pose.pt
INFERENCE_MAX_FRAMES=1000
INFERENCE_CONF_THRESHOLD=0.4
INFERENCE_IOU_THRESHOLD=0.5
INFERENCE_IMGSZ=640

# Annotated-video encoder. Auto-picks h264_nvenc (NVIDIA GPU) if ffmpeg
# exposes it, else libx264 (CPU), else falls back to OpenCV mp4v.
# Override to force: h264_nvenc | libx264 | cv2
# VIDEO_ENCODER=h264_nvenc
